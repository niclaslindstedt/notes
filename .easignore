# What `eas build` leaves out of the upload. EAS reads this file from the
# repository root, and when it exists it is used INSTEAD of every .gitignore
# in the tree — so the rules below are the .gitignore files' own (root,
# native/, notesd/), with one deliberate difference:
#
#   native/assets/webroot.zip is NOT ignored here. It is the packed web app,
#   built by `npm run bundle` in native/ (in CI, by
#   .github/workflows/native-build.yml, which bakes the Dropbox key into it)
#   and required by native/src/local-server.ts. It is gitignored because it is
#   build output; left out of the upload, the EAS worker fails at "Unable to
#   resolve module ../assets/webroot.zip".
#
# Keep this in step with the .gitignore files when they change. Check with
#   (cd native && npx eas-cli build:inspect -p ios -s archive -o <dir>)
# that the archive holds native/assets/webroot.zip.

# Common
.DS_Store
*.log
*.tmp
.env
.env.local
.env*.local

# Editors
.vscode/
.idea/
*.swp

# Coverage
.coverage/
coverage/

# Generated docs
docs/_build/

# Node / Vite
node_modules/
dist/
dev-dist/
.vite/
web-build/

# Service worker output
public/sw.js
public/workbox-*.js

# React Native / Expo — generated by `expo prebuild`, which runs on the EAS
# worker. Anchored: a bare `ios/` would also drop modules/*/ios, the native
# modules' own sources.
.expo/
native/android/
native/ios/
native/.metro-health-check*
# The unzipped web build webroot.zip is packed from; only the zip goes up.
native/web/
native/package-lock.json

# Transient release artifacts
.release-notes.md

# Store submission output and the listing's words (see .gitignore)
native/store/copy.mts
native/store/store.config.json
native/store/screenshots/
native/fastlane/metadata/

# Credentials — never uploaded
play-service-account.json
*.p8
*.p12
*.keystore

# The desktop shell's and the daemon's build output
tauri/target/
tauri/webroot/*
!tauri/webroot/.gitkeep
tauri/src-tauri/gen/
notesd/target/
