{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "mainBinaryName": "notes",
  "version": "../../package.json",
  "identifier": "dev.local.notes",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "category": "Productivity",
    "shortDescription": "a local-first notes app",
    "longDescription": "A local-first notes app that works on mobile and desktop, with folders, namespaces and optional sync to a folder, Dropbox or your own Nextcloud. Your notes stay on your machine.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
