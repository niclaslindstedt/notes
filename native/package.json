{
  "name": "notes-native",
  "version": "0.1.0",
  "private": true,
  "description": "Thin React Native (Expo) WebView wrapper around the notes web PWA. Packs the compiled web app into assets/webroot.zip, serves it from a loopback origin on the device, and adds native haptics, iCloud Drive and a Dropbox sign-in sheet.",
  "main": "index.js",
  "scripts": {
    "bundle": "node scripts/bundle-web.mjs",
    "bundle:zip": "node scripts/bundle-web.mjs --skip-build",
    "start": "expo start",
    "prebuild": "expo prebuild --clean",
    "ios": "npm run bundle && expo run:ios",
    "android": "npm run bundle && expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@dr.pogodin/react-native-static-server": "^0.28.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
