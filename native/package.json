{
  "name": "notes-native",
  "version": "0.1.0",
  "private": true,
  "description": "Thin React Native (Expo) WebView wrapper around the notes web PWA. Embeds the compiled web app (built into ./web) and adds only native haptics and SPKI-pinned HTTPS for the self-hosted notesd backend.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.6",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
