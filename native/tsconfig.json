{
  "$schema": "https://json.schemastore.org/tsconfig",
  // NOT `extends: "expo/tsconfig.base"`, and that is deliberate.
  //
  // `native/` is outside the root install with a dependency tree of its own,
  // so a plain `npm ci` at the repo root does NOT install `expo` here — which
  // is exactly what CI does. One root test imports a module from this tree
  // (`tests/platform/icloud-host.test.ts`, over `src/icloudBridge.ts`), and
  // Vite resolves the NEAREST tsconfig to every file it touches and fails hard
  // when an `extends` cannot be resolved. Reaching into node_modules for the
  // base therefore turns a fully-installed machine green and CI red.
  //
  // So Expo's base is inlined below, as of expo 57, with this project's own
  // settings on top (`jsx`, `strict`, `.ts` import extensions). Re-check it
  // against `node_modules/expo/tsconfig.base.json` when expo is upgraded.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": ["index.js", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts"],
  "exclude": ["node_modules"]
}
